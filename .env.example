# Copiez ce fichier en .env.local puis remplissez les valeurs.
# Ne versionnez jamais .env.local.

# URL publique du site, sans « / » final (sert aux métadonnées, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (étape 5) ---------------------------------------------------
# Dashboard Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : utilisée uniquement côté serveur. Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- E-mails transactionnels (étape 6, fournisseur à confirmer) -----------
EMAIL_PROVIDER_API_KEY=
# Adresse d'expédition (domaine notym.fr à authentifier : SPF / DKIM)
EMAIL_FROM=
# Destinataire des nouvelles demandes de devis et de contact
QUOTE_NOTIFICATION_EMAIL=achat@notym.fr
